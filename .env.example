# Copy into Vercel → Settings → Environment Variables (never commit real values).

# Required: password for the login page (min. 10 characters). The whole platform is locked without it.
DWP_ACCESS_PASSWORD=
# Optional: if set, the login page also asks for this username.
DWP_ACCESS_USERNAME=

# Indodax: Trade API key with view + trade permission only (no withdraw).
INDODAX_API_KEY=
INDODAX_API_SECRET=

# Tokocrypto: API key with read + spot trading only (no withdraw).
TOKOCRYPTO_API_KEY=
TOKOCRYPTO_API_SECRET=

# Leave empty for test mode (orders are checked but not sent). Set to "on" to send real orders.
DWP_LIVE_TRADING=

# Per-order caps in the quote currency (defaults: 500000 IDR, 30 USDT).
DWP_MAX_ORDER_IDR=
DWP_MAX_ORDER_USDT=

# Allowed pairs (defaults shown).
DWP_PAIRS_INDODAX=btc_idr,eth_idr,usdt_idr
DWP_PAIRS_TOKOCRYPTO=BTC_USDT,ETH_USDT

# ── Automatic trading bot ─────────────────────────────────────
# Lets the schedule run the bot without the app open (min. 16 characters, random).
# Put the same value in GitHub → repository → Settings → Secrets → Actions as DWP_BOT_SECRET.
CRON_SECRET=
# Set automatically when a private Blob store is connected (Vercel → Storage → Blob).
# The bot keeps its settings, positions and journal there.
BLOB_READ_WRITE_TOKEN=
